# ==============================================================
# PsicoSST — Environment Configuration
# Copy to .env and fill in your values
# ==============================================================

# --- Database ---
POSTGRES_USER=psicosst
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=psicosst
DATABASE_URL="postgresql://psicosst:change_me_strong_password@localhost:5432/psicosst?schema=public"
# En Neon usa el endpoint CON pooling (el del sufijo `-pooler`) para la
# aplicación. Las migraciones (`prisma migrate deploy`) necesitan el endpoint
# DIRECTO: PgBouncer no soporta los bloqueos de aviso que usa el migrador.

# --- NextAuth.js ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# --- Application ---
NODE_ENV=development
APP_NAME=PsicoSST
APP_LOCALE=es-CO

# --- Security ---
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
BCRYPT_ROUNDS=12

# --- Report Signing ---
# RSA private key path for digital signature (production only)
# SIGNING_KEY_PATH=/etc/psicosst/signing-key.pem

# --- Inteligencia artificial (OpenRouter) ---
# Sin esta clave la aplicación funciona, pero omite el análisis clínico
# asistido, el diagnóstico organizacional y la lectura consultiva del informe
# colectivo. Se obtiene en https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Modelos. Los valores por defecto (ver src/lib/ai/models.ts) son económicos
# para desarrollo y pruebas; en producción conviene subir el de análisis.
# Catálogo vigente: https://openrouter.ai/api/v1/models
# AI_MODEL_ANALYSIS=anthropic/claude-sonnet-5
# AI_MODEL_DRAFTING=anthropic/claude-haiku-4.5

# --- Generación de informes ---
# Hosts desde los que el servidor puede descargar el logo del consultorio.
# Vacío por defecto: sólo se aceptan imágenes guardadas como data URI.
# REPORT_IMAGE_ALLOWED_HOSTS=cdn.tudominio.com

# --- Pagos: Mercado Pago (Colombia · COP) ---
# Panel: https://www.mercadopago.com.co/developers/panel
#
# Las dos credenciales deben ser del MISMO juego: o ambas de prueba (TEST-…) o
# ambas de producción (APP_USR-…). Mezclarlas produce el fallo más difícil de
# diagnosticar de la integración — el formulario tokeniza sin quejarse y el
# cobro revienta después. La aplicación valida el par al arrancar.
#
# Sin estas variables la aplicación funciona con normalidad, pero el checkout
# responde «pagos no disponibles» en lugar de fallar con un error 500.
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-0000000000
NEXT_PUBLIC_MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000

# Clave de firma del webhook. Se genera en el panel al crear la notificación
# apuntando a  https://TU-DOMINIO/api/payments/webhook
# Sin ella el webhook RECHAZA todas las notificaciones: es la única defensa de
# un endpoint que no tiene sesión que validar.
MP_WEBHOOK_SECRET=

# OJO: NEXT_PUBLIC_MP_PUBLIC_KEY se incrusta en el paquete del navegador
# durante la compilación. Cambiar de pruebas a producción exige un nuevo
# despliegue, no basta con editar la variable en Vercel.

# --- Tareas programadas ---
# Protege /api/payments/reconcile-stale, que rescata los pagos de PSE y Efecty
# cuyo webhook se perdió. Vercel Cron envía `Authorization: Bearer $CRON_SECRET`.
# Generar con: openssl rand -hex 32
CRON_SECRET=
