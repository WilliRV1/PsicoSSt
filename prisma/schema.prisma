generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Licensed psychologist (system user)
model Psychologist {
  id               String        @id @default(uuid()) @db.Uuid
  email            String        @unique
  passwordHash     String        @map("password_hash")
  fullName         String        @map("full_name")
  licenseNumber    String        @unique @map("license_number")
  professionalCard String        @map("professional_card")
  sstCredential    String        @map("sst_credential")
  sstLicenseDate   DateTime?     @map("sst_license_date")
  mfaSecret        String?       @map("mfa_secret")
  mfaEnabled       Boolean       @default(false) @map("mfa_enabled")
  /// Método vigente de verificación en dos pasos. TOTP usa mfaSecret; EMAIL
  /// usa mfaEmailCodeHash, generado y enviado en cada intento de login.
  mfaMethod        MfaMethod     @default(TOTP) @map("mfa_method")
  /// SHA-256 del código de un solo uso enviado por correo; el código en
  /// claro nunca se persiste, igual que los tokens de invitación.
  mfaEmailCodeHash String?       @map("mfa_email_code_hash")
  mfaEmailCodeExpiresAt DateTime? @map("mfa_email_code_expires_at")
  /// Cuándo el servidor validó por última vez un código real (TOTP o
  /// correo) para esta cuenta. Es la ÚNICA fuente de verdad de si el
  /// segundo factor está satisfecho en la sesión vigente — nunca un booleano
  /// que el cliente pueda mandar directo a /api/auth/session. Ver
  /// callback jwt en lib/auth.ts.
  mfaVerifiedAt    DateTime?     @map("mfa_verified_at")
  status           AccountStatus @default(PENDING)
  isAdmin          Boolean       @default(false) @map("is_admin")
  failedAttempts   Int           @default(0) @map("failed_attempts")
  lockedUntil      DateTime?     @map("locked_until")
  lastLoginAt      DateTime?     @map("last_login_at")
  signature        String?       @map("signature") @db.Text
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  /// Current credit balance
  creditBalance      Int           @default(0) @map("credit_balance")

  // Relations
  assessments        Assessment[]
  auditLogs          AuditLog[]
  organizations      Organization[]
  generatedReports   GeneratedReport[]
  signatures         PsychologistSignature[]
  interventionPlans  InterventionPlan[]
  creditTransactions CreditTransaction[]
  resetTokens        PasswordResetToken[]
  paymentOrders      PaymentOrder[]
  settings           PsychologistSettings?
  assessmentReports  AssessmentReport[]
  assessmentInvitations AssessmentInvitation[]
  organizationInvitationLinks OrganizationInvitationLink[]

  @@map("psychologists")
  feedback              Feedback[]
}

/// Psychologist's digital signature (drawn or uploaded image)
model PsychologistSignature {
  id              String       @id @default(cuid())
  psychologistId  String       @map("psychologist_id") @db.Uuid
  psychologist    Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  signatureType   String       @map("signature_type") // "drawn" | "uploaded"
  /// Base64 encoded image for drawn signatures
  dataUrl         String?      @map("data_url") @db.Text
  /// URL for uploaded signature image
  imageUrl        String?      @map("image_url")
  /// Original filename for uploaded signatures
  fileName        String?      @map("file_name")
  uploadedAt      DateTime     @default(now()) @map("uploaded_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  /// One psychologist can have one drawn and one uploaded signature
  @@unique([psychologistId, signatureType])
  @@map("psychologist_signatures")
}

/// Global configuration and White Label settings for the psychologist
model PsychologistSettings {
  id                 String       @id @default(uuid()) @db.Uuid
  psychologistId     String       @unique @map("psychologist_id") @db.Uuid
  
  // Branding
  logoUrl            String?      @map("logo_url")
  consultingRoomName String?      @map("consulting_room_name")
  tradeName          String?      @map("trade_name")
  primaryColor       String?      @map("primary_color")
  secondaryColor     String?      @map("secondary_color")
  typography         String?      @default("inter")
  
  // Contact
  address            String?
  city               String?
  phone              String?
  website            String?
  email              String?
  
  // Preferences
  locale             String?      @default("es-CO")
  timezone           String?      @default("America/Bogota")
  
  psychologist       Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  
  @@map("psychologist_settings")
}

/// Company or organization being evaluated
model Organization {
  id                    String       @id @default(uuid()) @db.Uuid
  name                  String
  nit                   String       @unique
  economicSector        String?      @map("economic_sector")
  city                  String?
  department            String?
  employeeCount         Int?         @map("employee_count")
  contactName           String?      @map("contact_name")
  contactEmail          String?      @map("contact_email")
  contactPhone          String?      @map("contact_phone")
  createdByPsychologist String       @map("created_by_psychologist") @db.Uuid
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  assessments           Assessment[]
  psychologist          Psychologist @relation(fields: [createdByPsychologist], references: [id])
  workers               Worker[]
  interventionPlans     InterventionPlan[]
  assessmentReports     AssessmentReport[]
  assessmentInvitations AssessmentInvitation[]
  organizationInvitationLinks OrganizationInvitationLink[]

  @@map("organizations")
}

/// Worker/employee being assessed
model Worker {
  id                     String            @id @default(uuid()) @db.Uuid
  documentType           DocumentType      @map("document_type")
  documentId             String            @map("document_id")
  fullName               String            @map("full_name")
  gender                 String?
  birthDate              DateTime?         @map("birth_date")
  birthYear              Int?              @map("birth_year")
  maritalStatus          String?           @map("marital_status")
  educationLevel         String?           @map("education_level")
  profession             String?
  jobTitle               String?           @map("job_title")
  jobLevel               JobLevel          @map("job_level")
  residenceCity          String?           @map("residence_city")
  residenceDepartment    String?           @map("residence_department")
  socioeconomicStratum   String?           @map("socioeconomic_stratum")
  housingType            String?           @map("housing_type")
  dependentsCount        Int?              @map("dependents_count")
  workCity               String?           @map("work_city")
  workDepartment         String?           @map("work_department")
  freeTimeUsage          String[]          @map("free_time_usage")
  transportMeans         String?           @map("transport_means")
  displacementTime       Int?              @map("displacement_time")
  hasCustomerInteraction Boolean           @default(true) @map("has_customer_interaction")
  /// Respuesta a "soy jefe de otras personas en mi trabajo", la pregunta de
  /// control que antecede a los ítems 115-123 de la forma A. Nula mientras no
  /// se haya aplicado un cuestionario que la formule.
  hasPeopleInCharge      Boolean?          @map("has_people_in_charge")
  departmentArea         String?           @map("department_area")
  lessThanOneYearInCompany Boolean?        @map("less_than_one_year_in_company")
  yearsInCompany         Int?              @map("years_in_company")
  lessThanOneYearInPosition Boolean?       @map("less_than_one_year_in_position")
  yearsInPosition        Int?              @map("years_in_position")
  contractType           String?           @map("contract_type")
  workSchedule           String?           @map("work_schedule")
  hoursPerDay            String?           @map("hours_per_day")
  hoursPerWeek           String?           @map("hours_per_week")
  paymentModality        String?           @map("payment_modality")
  organizationId         String            @map("organization_id") @db.Uuid
  /// Cuándo el trabajador diligenció sus propios sociodemográficos vía
  /// enlace de autoservicio (después de firmar consentimiento, antes del
  /// primer cuestionario). Nula = pendiente o cargado manual por psicólogo.
  sociodemographicsCompletedAt DateTime? @map("sociodemographics_completed_at")
  /// Archivado lógico. El Dec. 1072/2015 art. 2.2.4.6.13 obliga a conservar la
  /// evidencia 20 años desde el cese laboral, así que un trabajador con
  /// evaluaciones calificadas nunca se borra: se archiva y deja de listarse.
  archivedAt             DateTime?         @map("archived_at")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  assessments            Assessment[]
  consents               InformedConsent[]
  organization           Organization      @relation(fields: [organizationId], references: [id])
  assessmentInvitations  AssessmentInvitation[]

  @@unique([documentType, documentId, organizationId])
  @@index([organizationId])
  @@map("workers")
}

/// An assessment session (one battery application for one worker)
model Assessment {
  id                String            @id @default(uuid()) @db.Uuid
  workerId          String            @map("worker_id") @db.Uuid
  psychologistId    String            @map("psychologist_id") @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  formType          FormType          @map("form_type")
  questionnaireType QuestionnaireType @map("questionnaire_type")
  assessmentDate    DateTime          @map("assessment_date") @db.Date
  status            AssessmentStatus  @default(DRAFT)
  inputMethod       InputMethod       @default(MANUAL) @map("input_method")
  /// Respuestas de control vigentes CUANDO SE HIZO esta evaluación puntual.
  /// hasCustomerInteraction/hasPeopleInCharge en Worker son el valor actual y
  /// pueden cambiar con una evaluación posterior; sin esta copia, editar una
  /// evaluación vieja la recalificaba con un criterio de control que no
  /// aplicaba en la fecha en que se hizo. Nulo en filas anteriores a este
  /// campo (se usa el valor del trabajador como mejor aproximación).
  hasCustomerInteraction Boolean?     @map("has_customer_interaction")
  hasPeopleInCharge      Boolean?     @map("has_people_in_charge")
  notes             String?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  completedAt       DateTime?         @map("completed_at")
  organization      Organization      @relation(fields: [organizationId], references: [id])
  psychologist      Psychologist      @relation(fields: [psychologistId], references: [id])
  worker            Worker            @relation(fields: [workerId], references: [id])
  consent           InformedConsent?
  generatedReports  GeneratedReport[]
  responseSet       ResponseSet?
  scoredResult      ScoredResult?
  invitationAsIntra AssessmentInvitation? @relation("InvitationIntra")
  invitationAsExtra AssessmentInvitation? @relation("InvitationExtra")
  invitationAsStress AssessmentInvitation? @relation("InvitationStress")

  @@index([psychologistId, status])
  @@index([organizationId, assessmentDate])
  @@index([workerId])
  @@map("assessments")
}

/// Raw item responses for an assessment
model ResponseSet {
  id           String     @id @default(uuid()) @db.Uuid
  assessmentId String     @unique @map("assessment_id") @db.Uuid
  /// JSONB: { "1": 3, "2": 0, "3": 4, ... } — item number → Likert value (0-4)
  responses    Json
  totalItems   Int        @map("total_items")
  isComplete   Boolean    @default(false) @map("is_complete")
  submittedAt  DateTime?  @map("submitted_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("response_sets")
}

/// Scored results after running the scoring engine
model ScoredResult {
  id                  String       @id @default(uuid()) @db.Uuid
  assessmentId        String       @unique @map("assessment_id") @db.Uuid
  /// JSONB: per-dimension scores (raw, transformed, risk category, etc.)
  dimensionScores     Json         @map("dimension_scores")
  /// JSONB: per-domain aggregated scores
  domainScores        Json         @map("domain_scores")
  /// JSONB: total intralaboral/extralaboral/stress scores
  totalScores         Json         @map("total_scores")
  overallRiskCategory RiskCategory @map("overall_risk_category")
  scoredAt            DateTime     @default(now()) @map("scored_at")
  assessment          Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("scored_results")
}

/// Informed consent record
model InformedConsent {
  id             String        @id @default(uuid()) @db.Uuid
  assessmentId   String        @unique @map("assessment_id") @db.Uuid
  workerId       String        @map("worker_id") @db.Uuid
  consentText    String        @map("consent_text")
  consentGranted Boolean       @map("consent_granted")
  consentMethod  ConsentMethod @map("consent_method")
  /// Firma dibujada por el trabajador (dedo/mouse) como PNG base64. Nula en
  /// consentimientos tomados en persona por el psicólogo (VERBAL/WRITTEN).
  consentSignature String?     @map("consent_signature") @db.Text
  /// Identificador de la versión exacta del texto que se le mostró al
  /// trabajador. Sin esto no puede reconstruirse qué fue lo que autorizó,
  /// porque el texto cambia con cada despliegue (Ley 1581/2012 art. 6 y 12).
  consentVersion String?       @map("consent_version")
  ipAddress      String?       @map("ip_address")
  userAgent      String?       @map("user_agent") @db.Text
  consentedAt    DateTime      @default(now()) @map("consented_at")
  assessment     Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  worker         Worker        @relation(fields: [workerId], references: [id])

  @@map("informed_consents")
}

/// Generated and signed reports with versioning and immutable hashes
model GeneratedReport {
  id                String       @id @default(uuid()) @db.Uuid
  assessmentId      String       @unique @map("assessment_id") @db.Uuid
  psychologistId    String       @map("psychologist_id") @db.Uuid
  
  reportType        String       @default("individual") @map("report_type")
  
  // Versioning and Identification
  templateVersion   String       @default("classic-v1") @map("template_version")
  brandingVersion   String?      @map("branding_version")
  dictionaryVersion String       @default("v1.0") @map("dictionary_version")
  
  // Immutability and Verification
  contentHash       String?      @map("content_hash")
  versionHash       String?      @map("version_hash")
  /// URL del PDF archivado al firmar. El informe entregado debe poder
  /// recuperarse tal cual se entregó: recompilarlo con los datos del día
  /// impide probar qué documento se firmó (Dec. 1072/2015 art. 2.2.4.6.13).
  pdfUrl            String?      @map("pdf_url")
  pdfSize           Int?         @map("pdf_size")
  pages             Int?
  generatedBy       String?      @map("generated_by")
  
  /// JSONB: complete report data including narratives, recommendations
  reportData        Json         @map("report_data")
  status            ReportStatus @default(DRAFT)
  
  /// Base64 encoded signature image included in the PDF
  signatureImage    String?      @map("signature_image") @db.Text
  signedBy          String?      @map("signed_by")
  isFinalized       Boolean      @default(false) @map("is_finalized")
  
  /// IA-generated recommendations/next steps
  recommendationsAI String?      @map("recommendations_ai") @db.Text
  
  generatedAt       DateTime     @default(now()) @map("generated_at")
  signedAt          DateTime?    @map("signed_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  
  assessment        Assessment   @relation(fields: [assessmentId], references: [id])
  psychologist      Psychologist @relation(fields: [psychologistId], references: [id])

  @@index([assessmentId, status])
  @@index([psychologistId])
  @@map("generated_reports")
}

/// Immutable audit log (append-only)
model AuditLog {
  id           BigInt        @id @default(autoincrement())
  userId       String?       @map("user_id") @db.Uuid
  action       AuditAction
  resourceType String        @map("resource_type")
  resourceId   String?       @map("resource_id")
  /// JSONB: additional context (old values, new values, request details)
  metadata     Json?
  ipAddress    String?       @map("ip_address")
  userAgent    String?       @map("user_agent")
  createdAt    DateTime      @default(now()) @map("created_at")
  user         Psychologist? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Intervention plan per organization (required by Res. 2764/2022)
model InterventionPlan {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  psychologistId String               @map("psychologist_id") @db.Uuid
  title          String
  period         String
  status         PlanStatus           @default(ACTIVE)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  psychologist   Psychologist         @relation(fields: [psychologistId], references: [id])
  actions        InterventionAction[]

  @@index([organizationId])
  @@map("intervention_plans")
}

/// Triangulation report (Qualitative findings) per organization and year
model AssessmentReport {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  psychologistId String        @map("psychologist_id") @db.Uuid
  year           Int
  fieldFindings  String?       @map("field_findings") @db.Text
  status         ReportStatus  @default(DRAFT)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  psychologist   Psychologist  @relation(fields: [psychologistId], references: [id])

  @@unique([organizationId, year])
  @@index([organizationId])
  @@map("assessment_reports")
}

/// Individual action/measure within an intervention plan
model InterventionAction {
  id           String           @id @default(uuid()) @db.Uuid
  planId       String           @map("plan_id") @db.Uuid
  measure      String           @db.Text
  responsible  String
  dueDate      DateTime?        @map("due_date") @db.Date
  status       ActionStatus     @default(PENDING)
  riskCategory String?          @map("risk_category")
  area         String?
  notes        String?          @db.Text
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  plan         InterventionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("intervention_actions")
}

/// Bulk import job tracking
model ImportJob {
  id             String    @id @default(uuid()) @db.Uuid
  psychologistId String    @map("psychologist_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  fileName       String    @map("file_name")
  totalRows      Int       @map("total_rows")
  successRows    Int       @default(0) @map("success_rows")
  failedRows     Int       @default(0) @map("failed_rows")
  /// JSONB: array of { row, column, error } for each failed record
  errors         Json?
  status         String    @default("PENDING")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([psychologistId])
  @@map("import_jobs")
}

/// Psychologist account status
enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum MfaMethod {
  TOTP
  EMAIL
}

/// Type of questionnaire form
enum FormType {
  A
  B
}

/// Type of questionnaire / instrument
enum QuestionnaireType {
  INTRALABORAL
  EXTRALABORAL
  STRESS
}

/// Assessment lifecycle status
enum AssessmentStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  SCORED
  REVIEWED
  SIGNED
}

/// Risk category per Colombian battery manual
enum RiskCategory {
  INVALIDO
  SIN_RIESGO
  BAJO
  MEDIO
  ALTO
  MUY_ALTO
}

/// Input method for responses
enum InputMethod {
  MANUAL
  BULK
}

/// Report lifecycle status
enum ReportStatus {
  DRAFT
  REVIEWED
  SIGNED
  DELIVERED
}

/// Consent method
enum ConsentMethod {
  VERBAL
  WRITTEN
  DIGITAL
}

/// Document type for identification
enum DocumentType {
  CC
  CE
  TI
  PA
  OTHER
}

/// Worker education level (determines Form A vs B)
enum EducationLevel {
  PRIMARIA
  BACHILLERATO
  TECNICO
  TECNOLOGO
  PROFESIONAL
  ESPECIALIZACION
  MAESTRIA
  DOCTORADO
}

/// Job level category
enum JobLevel {
  JEFATURA
  PROFESIONAL
  TECNICO
  AUXILIAR
  OPERATIVO
}

/// Audit log action types
enum AuditAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  ACCOUNT_LOCKED
  CREATE
  READ
  UPDATE
  DELETE
  SCORE
  SIGN_REPORT
  EXPORT
  IMPORT
  CONSENT_RECORDED
  MFA_SETUP
  PASSWORD_CHANGE
  CREDIT_PURCHASE
  CREDIT_CONSUME
}

/// Housing type
enum HousingType {
  PROPIA
  ARRENDADA
  FAMILIAR
  OTRA
}

/// Free time usage categories
enum FreeTimeUsage {
  DEPORTE
  ESTUDIO
  FAMILIA
  RECREACION
  DESCANSO
  OTRO
}

/// Intervention plan lifecycle
enum PlanStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

/// Individual action status within a plan
enum ActionStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

/// Credit transaction for token-based billing
model CreditTransaction {
  id             String            @id @default(uuid()) @db.Uuid
  psychologistId String            @map("psychologist_id") @db.Uuid
  type           CreditTxType
  /// Positive for purchases/grants, negative for consumption
  amount         Int
  /// Running balance after this transaction
  balanceAfter   Int               @map("balance_after")
  /// Package ID for purchases (e.g. "starter", "pro")
  packageId      String?           @map("package_id")
  /// Price paid in COP (for purchases)
  priceCOP       Int?              @map("price_cop")
  /// Payment reference or external ID
  paymentRef     String?           @map("payment_ref")
  /// Related assessment ID (for consumption)
  assessmentId   String?           @map("assessment_id") @db.Uuid
  /// Description of the transaction
  description    String?
  createdAt      DateTime          @default(now()) @map("created_at")
  psychologist   Psychologist      @relation(fields: [psychologistId], references: [id])

  @@index([psychologistId, createdAt(sort: Desc)])
  @@map("credit_transactions")
}

/// Credit transaction types
enum CreditTxType {
  PURCHASE
  TRIAL_GRANT
  ADMIN_GRANT
  CONSUMPTION
  REFUND
}

/// Password reset token (6-digit code)
model PasswordResetToken {
  id             String       @id @default(uuid()) @db.Uuid
  psychologistId String       @map("psychologist_id") @db.Uuid
  codeHash       String       @map("code_hash")
  expiresAt      DateTime     @map("expires_at")
  attempts       Int          @default(0)
  used           Boolean      @default(false)
  createdAt      DateTime     @default(now()) @map("created_at")

  psychologist   Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([psychologistId, createdAt(sort: Desc)])
  @@map("password_reset_tokens")
}

/// Invitación de autoaplicación remota: token de un solo uso que permite a
/// un trabajador SIN cuenta diligenciar la batería (o parte de ella) por su
/// cuenta. Vive independiente de Assessment hasta completarse — recién ahí
/// se invoca AssessmentService.createAssessment (sin modificarla) por cada
/// tipo de cuestionario incluido en plannedTypes. El psicólogo que la crea
/// sigue siendo el responsable/custodio legal (Res. 2764/2022, art. 5.3).
model AssessmentInvitation {
  id                       String                     @id @default(uuid()) @db.Uuid
  workerId                 String                     @map("worker_id") @db.Uuid
  psychologistId           String                     @map("psychologist_id") @db.Uuid
  organizationId           String                     @map("organization_id") @db.Uuid
  formType                 FormType                   @map("form_type")
  /// Cuáles de los 3 instrumentos incluye esta invitación. String[] (no un
  /// array de enum) a propósito: un array de QuestionnaireType[] dispara un
  /// bug real de Prisma 7 + @prisma/adapter-pg ("isObjectEnumValue is not a
  /// function") — validado como QuestionnaireType en la capa de aplicación.
  plannedTypes             String[]                   @map("planned_types")
  /// SHA-256 del token; el token en claro nunca se persiste.
  tokenHash                String                     @unique @map("token_hash")
  status                   AssessmentInvitationStatus @default(PENDING)
  expiresAt                DateTime                   @map("expires_at")
  /// Correo capturado al invitar; no se persiste en Worker.
  contactEmail             String                     @map("contact_email")
  /// Se llenan a medida que el trabajador completa cada sección — sirven
  /// también como checkpoint de progreso si cierra la pestaña a mitad.
  intralaboralAssessmentId String?                    @unique @map("intralaboral_assessment_id") @db.Uuid
  extralaboralAssessmentId String?                    @unique @map("extralaboral_assessment_id") @db.Uuid
  stressAssessmentId       String?                    @unique @map("stress_assessment_id") @db.Uuid
  completedAt              DateTime?                  @map("completed_at")
  cancelledAt              DateTime?                  @map("cancelled_at")
  createdAt                DateTime                   @default(now()) @map("created_at")
  updatedAt                DateTime                   @updatedAt @map("updated_at")

  worker                 Worker       @relation(fields: [workerId], references: [id])
  psychologist           Psychologist @relation(fields: [psychologistId], references: [id])
  organization           Organization @relation(fields: [organizationId], references: [id])
  intralaboralAssessment Assessment?  @relation("InvitationIntra", fields: [intralaboralAssessmentId], references: [id])
  extralaboralAssessment Assessment?  @relation("InvitationExtra", fields: [extralaboralAssessmentId], references: [id])
  stressAssessment       Assessment?  @relation("InvitationStress", fields: [stressAssessmentId], references: [id])

  @@index([psychologistId, status])
  @@index([workerId])
  @@map("assessment_invitations")
}

enum AssessmentInvitationStatus {
  PENDING
  COMPLETED
  CANCELLED
}

/// Enlace único y reutilizable por empresa: el trabajador se identifica con
/// su cédula (en vez de recibir un token individual por correo) y desde ahí
/// se resuelve o crea su AssessmentInvitation puntual. Solo un enlace activo
/// por organización — crear uno nuevo revoca el anterior.
model OrganizationInvitationLink {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  psychologistId String    @map("psychologist_id") @db.Uuid
  formType       FormType  @map("form_type")
  /// Ver nota equivalente en AssessmentInvitation.plannedTypes sobre por qué
  /// es String[] y no un array de enum.
  plannedTypes   String[]  @map("planned_types")
  /// SHA-256 del token; el token en claro nunca se persiste.
  tokenHash      String    @unique @map("token_hash")
  isActive       Boolean   @default(true) @map("is_active")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  /// Cédulas fallidas consecutivas contra este enlace — sin esto, cualquiera
  /// podía probar documentos sin límite hasta acertar uno real. Se reinicia
  /// en cada identificación exitosa; al llegar al umbral, bloquea el enlace
  /// completo por un rato (ver identifyWorker).
  failedIdentifyAttempts Int       @default(0) @map("failed_identify_attempts")
  identifyLockedUntil    DateTime? @map("identify_locked_until")

  organization Organization @relation(fields: [organizationId], references: [id])
  psychologist Psychologist @relation(fields: [psychologistId], references: [id])

  @@index([organizationId, isActive])
  @@map("organization_invitation_links")
}

/// Payment order for Wompi integration
model PaymentOrder {
  id             String        @id @default(uuid()) @db.Uuid
  psychologistId String        @map("psychologist_id") @db.Uuid
  packageId      String        @map("package_id")
  amountCents    Int           @map("amount_cents")
  wompiRef       String?       @unique @map("wompi_ref")
  internalRef    String        @unique @map("internal_ref")
  status         PaymentStatus @default(PENDING)
  paymentMethod  String?       @map("payment_method")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  completedAt    DateTime?     @map("completed_at")

  psychologist   Psychologist  @relation(fields: [psychologistId], references: [id])

  @@index([psychologistId, createdAt(sort: Desc)])
  @@map("payment_orders")
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  VOIDED
  ERROR
}

/// Transport means used by the worker
enum TransportMeans {
  CAMINANDO
  BICICLETA
  MOTOCICLETA
  VEHICULO_PARTICULAR
  TRANSPORTE_MASIVO
  TRANSPORTE_PUBLICO
  TRANSPORTE_EMPRESA
  OTRO
}

/// Reporte enviado desde la aplicación: un comentario del profesional o un
/// error capturado automáticamente. Es el canal de retroalimentación del
/// piloto, y por eso guarda el contexto —la pantalla, el navegador— junto al
/// texto: sin él un "no me funciona" no es accionable.
model Feedback {
  id             String         @id @default(uuid()) @db.Uuid
  psychologistId String?        @map("psychologist_id") @db.Uuid
  kind           FeedbackKind   @default(COMMENT)
  /// Lo que escribió la persona, o el mensaje del error capturado.
  message        String         @db.Text
  /// Ruta de la aplicación desde la que se envió.
  path           String?
  /// Traza del error, cuando lo hubo.
  stack          String?        @db.Text
  /// JSONB: navegador, tamaño de ventana y demás contexto del envío.
  context        Json?
  status         FeedbackStatus @default(NEW)
  /// Nota interna del administrador al revisarlo.
  adminNote      String?        @map("admin_note") @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  psychologist   Psychologist?  @relation(fields: [psychologistId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([psychologistId])
  @@map("feedback")
}

enum FeedbackKind {
  /// Comentario o sugerencia escrita por el profesional.
  COMMENT
  /// Problema que el profesional reporta a mano.
  BUG
  /// Error capturado por la aplicación, sin intervención del usuario.
  CRASH
}

enum FeedbackStatus {
  NEW
  READ
  RESOLVED
}
